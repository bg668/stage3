{
  "version": "1.0",
  "note": "能力档位规则表。findings[].rule 必须引用这里的 id；档位（tier）和类别（category）由本表决定，report.json 中不能改写。category 取值需与第一阶段 capability_detection 的线索类型对齐。",
  "tiers": {
    "malicious": {"label": "恶意", "desc": "良性软件几乎不会做，单独出现即可支持恶意判定"},
    "suspicious": {"label": "可疑", "desc": "良性软件也会做，需要结合上下文判断"},
    "info": {"label": "信息", "desc": "解释行为所需的背景操作，本身不说明恶意"}
  },
  "categories": {
    "credential_access": "凭据访问",
    "collection": "信息收集",
    "process_injection": "进程注入",
    "persistence": "持久化",
    "defense_evasion": "防御规避",
    "network": "网络通信",
    "impact": "破坏与勒索",
    "execution": "执行",
    "discovery": "环境探测",
    "config": "配置与资源",
    "file_ops": "文件操作"
  },
  "rules": [
    {"id": "CRED-DECRYPT", "category": "credential_access", "tier": "malicious", "desc": "调用 DPAPI、NSS 等接口解密浏览器、系统或第三方软件保存的凭据"},
    {"id": "CRED-READ", "category": "credential_access", "tier": "malicious", "desc": "读取第三方软件或凭据管理器中保存的账号密码（注册表、配置文件、CredEnumerate）"},
    {"id": "CRED-LSA", "category": "credential_access", "tier": "malicious", "desc": "读取 LSA Secrets、LSA 私有数据或 LSASS 内存"},
    {"id": "KEYLOG", "category": "collection", "tier": "malicious", "desc": "记录按键，并能看到保存或外传路径"},
    {"id": "SCREEN-CAPTURE", "category": "collection", "tier": "suspicious", "desc": "截取屏幕"},
    {"id": "BROWSER-DATA", "category": "collection", "tier": "suspicious", "desc": "读取浏览器历史、表单、Cookie（不含解密凭据）"},
    {"id": "STAGE-COLLECTED", "category": "collection", "tier": "suspicious", "desc": "把采集结果写入本地暂存文件"},
    {"id": "INPUT-HOOK", "category": "collection", "tier": "suspicious", "desc": "安装全局键盘或鼠标 hook，但未见保存或外传"},
    {"id": "INJ-REMOTE-THREAD", "category": "process_injection", "tier": "malicious", "desc": "向其他进程写内存并创建远程线程"},
    {"id": "INJ-PE-MAP", "category": "process_injection", "tier": "malicious", "desc": "把 PE 映像手工映射到其他进程（节复制、重定位、导入表修补）"},
    {"id": "INJ-HOLLOW", "category": "process_injection", "tier": "malicious", "desc": "以挂起方式创建进程并替换其映像（进程镂空）"},
    {"id": "PERSIST-RUNKEY", "category": "persistence", "tier": "suspicious", "desc": "写 Run、RunOnce 或 Policies\\Explorer\\Run"},
    {"id": "PERSIST-ACTIVESETUP", "category": "persistence", "tier": "suspicious", "desc": "创建 Active Setup 组件并设置 StubPath"},
    {"id": "PERSIST-SERVICE", "category": "persistence", "tier": "suspicious", "desc": "创建或修改服务"},
    {"id": "PERSIST-TASK", "category": "persistence", "tier": "suspicious", "desc": "创建计划任务"},
    {"id": "EVADE-ANTIVM-EXIT", "category": "defense_evasion", "tier": "suspicious", "desc": "检测虚拟机、沙箱或调试器后退出或改变行为"},
    {"id": "EVADE-SELFDELETE", "category": "defense_evasion", "tier": "suspicious", "desc": "删除自身或自身落地文件"},
    {"id": "EVADE-DISABLE-SECURITY", "category": "defense_evasion", "tier": "malicious", "desc": "关闭或篡改安全软件、日志、系统防护"},
    {"id": "EXFIL-NET", "category": "network", "tier": "malicious", "desc": "把采集数据通过网络发出"},
    {"id": "C2-COMM", "category": "network", "tier": "malicious", "desc": "与硬编码地址通信并按返回内容执行指令"},
    {"id": "NET-CONNECT", "category": "network", "tier": "suspicious", "desc": "发起网络连接，但用途未闭合"},
    {"id": "ENCRYPT-FILES", "category": "impact", "tier": "malicious", "desc": "批量加密用户文件"},
    {"id": "INHIBIT-RECOVERY", "category": "impact", "tier": "malicious", "desc": "删除卷影副本、备份或禁用系统恢复"},
    {"id": "PROC-SPAWN", "category": "execution", "tier": "info", "desc": "启动其他进程"},
    {"id": "DOWNLOAD-EXEC", "category": "execution", "tier": "malicious", "desc": "下载并执行外部载荷"},
    {"id": "ENV-DISCOVERY", "category": "discovery", "tier": "info", "desc": "读取系统目录、用户名、系统版本等环境信息"},
    {"id": "MUTEX-INSTANCE", "category": "execution", "tier": "info", "desc": "用互斥体控制单实例或行为分支"},
    {"id": "CONFIG-DECODE", "category": "config", "tier": "info", "desc": "解析或解密内嵌配置"},
    {"id": "FILE-COPY", "category": "file_ops", "tier": "info", "desc": "复制文件，源或目标未闭合"},
    {"id": "FILE-COPY-SELF", "category": "file_ops", "tier": "suspicious", "desc": "把自身复制到其他路径"}
  ]
}
